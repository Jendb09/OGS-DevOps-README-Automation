{
  "name": "ogs-devops-deployment",
  "version": "1.0.0",
  "private": true,
  "description": "Assignment 5 - automated testing with measured coverage and gated deployments",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/build.test.js tests/build-metadata.test.js",
    "test:integration": "node --test tests/integration-check.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=scripts/build-metadata.js tests/build.test.js tests/build-metadata.test.js"
  },
  "engines": {"node": ">=22"}
}
